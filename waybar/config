{
    "layer": "bottom",
    "position": "top",
    "modules-left": ["hyprland/workspaces", "custom/music"],
    "modules-center": ["clock"],
    "modules-right": [
        "backlight", 
        "battery", 
        "pulseaudio", 
        "bluetooth", 
        "cpu", 
        "memory", 
        "disk", 
        "tray"
    ],
    "height": 30,
    "clock": {
        "timezone": "Europe/London",
        "format": "{:%H:%M}",
        "interval": 1,
        "tooltip-format": "{calendar}",
        "calendar": {
            "format": {
                "today": "<span color='#f38ba8'><b>{}</b></span>",
            },
        },
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 5,
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
        "tooltip": false,
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {device_alias}",
    },

    "cpu": {
        "format": " {usage}%",
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "<span color='#f38ba8'>󰸈 {volume}%</span>",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    },

    "memory": {
        "interval": 10,
        "format": " {used:0.1f} GiB"
    },

    "tray": {
        "spacing": 5,
    },

    "disk": {
        "format": "󰋊 {specific_free:0.1f} GiB",
        "unit": "GiB"
    },

    "custom/music" : {
        "exec": "../../music-waybar-module/build/music-waybar-module",
        "exec-if": "pgrep spotify",
        "format": "{text}",
        "return-type": "json",
        "max-length": 25,
    },
}
