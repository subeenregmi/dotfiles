{
    "layer": "bottom",
    "position": "top",
    "modules-left": ["hyprland/workspaces", "bluetooth", "custom/music"],
    "modules-center": ["clock"],
    "modules-right": [
        "network",
        "backlight",
        "battery",
        "pulseaudio",
        "cpu",
        "memory",
        "disk",
        "idle_inhibitor",
        "tray"
    ],
    "height": 38,
    "margin-left": 5,
    "margin-right": 5,
    "clock": {
        "timezone": "Europe/London",
        "format": "{:%H:%M}",
        "interval": 1, "tooltip-format": "{calendar}",
        "calendar": {
            "format": {
                "today": "<span color='#f38ba8'><b>{}</b></span>",
            },
        },
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 5,
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
        "tooltip": false,
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {device_alias}",
    },

    "cpu": {
        "format": " {usage}%",
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "<span color='#f38ba8'>󰸈 {volume}%</span>",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    },

    "memory": {
        "interval": 10,
        "format": " {used:0.1f} GiB"
    },

    "tray": {
        "spacing": 5,
        "icon-size": 21
    },

    "disk": {
        "format": "󰋊 {specific_free:0.1f} GiB",
        "unit": "GiB"
    },

    "custom/music" : {
        "exec": "/home/subeen/subeenfiles/code/music-waybar-module/build/music-waybar-module",
        "format": "{icon}{text}",
        "format-icons": {
            "spotify":"󰓇",
            "feishin":"󰝚",
            "music": "󰝚",
            "firefox": "󰈹",
            "empty": "󰝚"
        },
        "return-type": "json",
        "max-length": 30,
    },

    "network": {
        "format-wifi": "󰖩 {bandwidthUpBytes} 󰁝 {bandwidthDownBytes} 󰁅",
        "format-ethernet": "󰈀 {bandwidthUpBytes} 󰁝 {bandwidthDownBytes} 󰁅",
        "format-disconnected": "󰖪",
        "interval": 2,
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
}
